<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ComIbmCompute.msgnode="ComIbmCompute.msgnode"
    xmlns:ComIbmMQGet.msgnode="ComIbmMQGet.msgnode"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:eflow="http://www.ibm.com/wbi/2005/eflow"
    xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility"
    nsURI="getMessage.subflow"
    nsPrefix="getMessage.subflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1" nodeLayoutStyle="RECTANGLE">
    <eSuperTypes href="http://www.ibm.com/wbi/2005/eflow#//FCMBlock"/>
    <translation xmi:type="utility:TranslatableString" key="getMessage" bundleName="getMessage" pluginId="MQClientAPI"/>
    <colorGraphic16 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/MQClientAPI/icons/full/obj16/getMessage.gif"/>
    <colorGraphic32 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/MQClientAPI/icons/full/obj30/getMessage.gif"/>
    <composition>
      <!-- Subflow entry point -->
      <nodes xmi:type="eflow:FCMSource" xmi:id="InTerminal.Input_1" location="25,25">
        <translation xmi:type="utility:TranslatableString" key="Input" bundleName="getMessage" pluginId="MQClientAPI"/>
      </nodes>
      <!-- MQ Get: gets next message from DEV.QUEUE.1; no-wait (returns immediately) -->
      <nodes xmi:type="ComIbmMQGet.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="200,25"
             queueName="DEV.QUEUE.1"
             failureAction="MQRC_NO_MSG_AVAILABLE"
             waitInterval="0"
             transactionMode="automatic"
             policyUrl="{MQClientPolicy}:MQEndpoint"
             policyProjectName="MQClientPolicy"
             policyName="{MQClientPolicy}:MQEndpoint">
        <translation xmi:type="utility:ConstantString" string="MQ Get"/>
      </nodes>
      <!-- Build JSON response with the message text -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="390,25"
             computeExpression="esql://routine/#getMessage_BuildResponse.Main"
             computeMode="destinationAndMessage">
        <translation xmi:type="utility:ConstantString" string="BuildResponse"/>
      </nodes>
      <!-- Build HTTP 204 response when queue is empty (no-message path) -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_3" location="390,110"
             computeExpression="esql://routine/#getMessage_BuildEmptyResponse.Main"
             computeMode="destinationAndMessage">
        <translation xmi:type="utility:ConstantString" string="BuildEmptyResponse"/>
      </nodes>
      <!-- Subflow exit point -->
      <nodes xmi:type="eflow:FCMSink" xmi:id="OutTerminal.Output_1" location="570,25">
        <translation xmi:type="utility:TranslatableString" key="Output" bundleName="getMessage" pluginId="MQClientAPI"/>
      </nodes>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_1"
                   sourceNode="InTerminal.Input_1" targetNode="FCMComposite_1_1"
                   sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <!-- MQ Get 'out' terminal: message retrieved -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_2"
                   sourceNode="FCMComposite_1_1" targetNode="FCMComposite_1_2"
                   sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_3"
                   sourceNode="FCMComposite_1_2" targetNode="OutTerminal.Output_1"
                   sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <!-- MQ Get 'noMessage' terminal: queue empty -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_4"
                   sourceNode="FCMComposite_1_1" targetNode="FCMComposite_1_3"
                   sourceTerminalName="OutTerminal.noMessage" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_5"
                   sourceNode="FCMComposite_1_3" targetNode="OutTerminal.Output_1"
                   sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
    </composition>
    <propertyOrganizer/>
    <stickyBoard/>
  </eClassifiers>
</ecore:EPackage>
