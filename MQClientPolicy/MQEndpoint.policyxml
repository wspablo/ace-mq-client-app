<policies>
  <policy policyType="MQEndpoint" policyName="MQEndpoint" policyTemplate="MQEndpoint">
    <connection>CLIENT</connection>
    <destinationQueueManagerName>QUICKSTART</destinationQueueManagerName>
    <queueManagerHostname>quickstart-nativeha-ibm-mq.mq-demo.svc.cluster.local</queueManagerHostname>
    <listenerPortNumber>1414</listenerPortNumber>
    <channelName>DEV.APP.SVRCONN</channelName>
    <CCDTUrl></CCDTUrl>
    <securityIdentity></securityIdentity>
    <!-- TLS: one-way authentication (server cert only, no mutual auth) -->
    <useSSL>true</useSSL>
    <!-- SSLPeerName left empty: no DN check required for self-signed cert -->
    <SSLPeerName></SSLPeerName>
    <SSLCipherSpec>ANY_TLS12_OR_HIGHER</SSLCipherSpec>
    <SSLCertificateLabel></SSLCertificateLabel>
    <MQApplName></MQApplName>
    <reconnectOption>default</reconnectOption>
  </policy>
</policies>
